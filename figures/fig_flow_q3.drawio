        <mxCell id="a4" value="硬约束校验: 06-18起飞 · ≤20返场 · 不过夜 · 周转≥30min · 机队配额 · 时刻链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
