          <mxGeometry x="380" y="150" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="② 否则 try_open_trip 新开&#10;多日重试(紧窗+2日, 倒班+8日)&#10;机型T3/T2/T1 · 续航门控" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=top" vertex="1" parent="1">
