<mxfile host="65bd74444e">
  <diagram name="续航加油决策" id="refuel">
    <mxGraphModel dx="1100" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="续航（加油）决策流程" style="text;html=1;align=center;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="10" width="280" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="s" value="架次从机场满油起飞 (F₀ = W_t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="50" width="340" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="loop" value="对每一航段 i→i+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="300" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="calc" value="计算到达下一点余油:&#10;F_{i+1} = F_i − c_t · d(s_i, s_{i+1})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="340" y="162" width="320" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="F_{i+1} ≥ 安全余油 s_t ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="340" y="230" width="320" height="60" as="geometry"/>
        </mxCell>
        <!-- 否：需加油 -->
        <mxCell id="need" value="需在前一停靠 s_i 加油" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="690" y="235" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="isrefuel" value="s_i 是可加油设施?&#10;(8个: F006/011/018/024/031/038/044/050)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="refuel" value="在 s_i 加满 (refuel=1)&#10;F_i = W_t, 停靠≥20min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="690" y="390" width="240" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="insert" value="在路径插入最近可加油设施 (≤2个)&#10;受 5次着陆上限约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="240" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="infeas" value="不可行 → 换大机型 / 拆分架次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="240" height="36" as="geometry"/>
        </mxCell>
        <!-- 是：继续 -->
        <mxCell id="arr" value="飞到 s_{i+1} (余油=安全余油以上)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="isnext" value="还有下一航段?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="370" y="380" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="架次续航可行 ✓&#10;返回 routes (含 refuel 标记)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="320" height="40" as="geometry"/>
        </mxCell>
        <!-- 机场行约束 -->
        <mxCell id="note" value="约束: 机场行 refuel=0; refuel=1 仅可加油设施; 满油起飞; 返场余油≥s_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="400" height="36" as="geometry"/>
        </mxCell>
        <!-- edges -->
        <mxCell e1="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;" source="s" target="loop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e2="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;" source="loop" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e3="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;" source="calc" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e4="1" parent="1" value="否" style="edgeStyle=orthogonalEdgeStyle;" source="gate" target="need"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e5="1" parent="1" value="是" style="edgeStyle=orthogonalEdgeStyle;" source="gate" target="arr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e6="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;" source="need" target="isrefuel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e7="1" parent="1" value="是" style="edgeStyle=orthogonalEdgeStyle;" source="isrefuel" target="refuel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e8="1" parent="1" value="否" style="edgeStyle=orthogonalEdgeStyle;" source="isrefuel" target="insert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e9="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;" source="insert" target="infeas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e10="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;" source="arr" target="isnext"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e11="1" parent="1" value="是" style="edgeStyle=orthogonalEdgeStyle;" source="isnext" target="loop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell e12="1" parent="1" value="否" style="edgeStyle=orthogonalEdgeStyle;" source="isnext" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
